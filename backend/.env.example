# ====================================================
# .env.example - Plantilla de configuracion
# ====================================================
# Copia este archivo a .env y rellena con tus datos:
#
#   Linux/macOS:  cp .env.example .env
#   Windows CMD:  copy .env.example .env
#
# IMPORTANTE: El archivo .env NUNCA debe subirse a git.
# Ya esta protegido por .gitignore.
# ====================================================

# ── Credenciales de las camaras ─────────────────────
# Usuario y contrasena compartidos por todas las camaras
CAMERA_USER=[USER]
CAMERA_PASS=[PASSWORD]

# ── Camaras: IP, nombre, rol y grupo ────────────────
# Agrega o elimina bloques CAMERA_N_* segun cuantas camaras tengas.
# El sistema detecta automaticamente todas las que esten definidas.
#
# Roles disponibles:
#   both     = la camara cuenta entradas Y salidas (comportamiento normal)
#   in_only  = la camara solo cuenta entradas
#   out_only = la camara solo cuenta salidas
#
# Grupo logico:
#   Camaras con el mismo GROUP se consolidan en los reportes como un solo punto.
#   Util cuando una camara ve solo entradas y otra solo salidas de la misma puerta.

CAMERA_0_IP=192.168.1.100
CAMERA_0_NAME=Camara1
CAMERA_0_ROLE=both
# CAMERA_0_GROUP=puerta_principal

# Ejemplo: dos camaras para la misma puerta (una por sentido)
# CAMERA_1_IP=192.168.1.101
# CAMERA_1_NAME=Entrada_Principal
# CAMERA_1_ROLE=in_only
# CAMERA_1_GROUP=puerta_principal
#
# CAMERA_2_IP=192.168.1.102
# CAMERA_2_NAME=Salida_Principal
# CAMERA_2_ROLE=out_only
# CAMERA_2_GROUP=puerta_principal

# ── Configuracion de polling ─────────────────────────
# Intervalo entre consultas a la camara (segundos).
# Minimo recomendado: 2 (para no saturar la CPU de la camara).
POLL_INTERVAL_SECONDS=3

# ── Conexion ONVIF ───────────────────────────────────
# Puerto ONVIF de la camara (Hanwha usa 80 por defecto).
ONVIF_PORT=80
# Segundos maximos para conectar/responder antes de dar la camara por caida.
ONVIF_TIMEOUT=8
# Vida de la suscripcion de eventos en la camara (se renueva sola a la mitad).
ONVIF_SUBSCRIPTION_TTL=120
# Enviar Unsubscribe al reconectar. Dejar en false si un NVR tambien recibe
# eventos de la camara: algunas cancelan TODAS las suscripciones al recibirlo.
ONVIF_UNSUBSCRIBE=false
# Espera maxima entre reintentos de reconexion (2s, 4s, 8s... hasta este valor).
RECONNECT_MAX_DELAY=60
# Perfil de video (SUNAPI) para el video en vivo del dashboard. Vacio = MJPEG por
# defecto, que en Hanwha es el perfil de grabacion y va a 2-5 fps. Crea un perfil
# MJPEG propio en la camara y pon aqui su numero. Usa fps que la camara pueda
# sostener (XNO-6120R: 800x448 a 8 fps); si se pide mas, los cuadros se encolan
# y el video se atrasa varios segundos.
# VIDEO_PROFILE=4

# ── Modo demo ────────────────────────────────────────
# true = no se conecta a las camaras y genera cruces simulados.
# Util para presentar el sistema sin camara. Dejar en false en produccion.
DEMO_MODE=false

# ── Base de datos ────────────────────────────────────
# SQLite (por defecto, sin instalar nada extra):
DATABASE_URL=sqlite:///./conteo_personas.db
#
# PostgreSQL (para produccion / ML):
# DATABASE_URL=postgresql://usuario:contrasena@localhost/conteo_personas

# ── Zona horaria y horario de negocio ────────────────
# Lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Ejemplos: America/Lima | America/Bogota | America/Mexico_City | America/New_York
TIMEZONE=America/Lima

# Rango horario en que opera el negocio.
# El sistema guarda un registro de "sin actividad" (heartbeat) una vez por hora
# dentro de este rango, lo que preserva la continuidad en los reportes historicos.
# Fuera del rango no se generan registros cuando no hay cruces.
# 0 = medianoche inicio del dia, 24 = medianoche fin del dia.
# Para operacion 24/7 deja los valores 0 y 24.
BUSINESS_HOUR_START=0
BUSINESS_HOUR_END=24
