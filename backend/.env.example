# ====================================================
# .env.example - Plantilla de configuración
# ====================================================
# Copia este archivo a .env y rellena con tus datos:
#
#   Linux/macOS:  cp .env.example .env
#   Windows CMD:  copy .env.example .env
#
# IMPORTANTE: El archivo .env NUNCA debe subirse a git.
# Ya está protegido por .gitignore.
# ====================================================

# ── Credenciales de las cámaras ─────────────────────
# Usuario y contraseña compartidos por todas las cámaras
CAMERA_USER=[USER]
CAMERA_PASS=[PASSWORD]

# ── IPs y nombres de las cámaras ────────────────────
# Agrega o elimina bloques CAMERA_N_* según cuántas cámaras tengas.
# El sistema detecta automáticamente todas las que estén definidas.

CAMERA_0_IP=192.168.1.100
CAMERA_0_NAME=Camara1

CAMERA_1_IP=192.168.1.101
CAMERA_1_NAME=Camara2

CAMERA_2_IP=192.168.1.102
CAMERA_2_NAME=Camara3

CAMERA_3_IP=192.168.1.103
CAMERA_3_NAME=Camara4

# ── Configuración de polling ─────────────────────────
# Intervalo entre consultas a la cámara (segundos).
# Mínimo recomendado: 2 (para no saturar la CPU de la cámara).
POLL_INTERVAL_SECONDS=3

# ── Base de datos ────────────────────────────────────
# SQLite (por defecto, sin instalar nada extra):
DATABASE_URL=sqlite:///./conteo_personas.db
#
# PostgreSQL (para producción / ML):
# DATABASE_URL=postgresql://usuario:contraseña@localhost/conteo_personas
